# 复制成 .env 再填。.env 不进版本库。

# 代码版直接调模型（OpenAI 兼容接口）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# 和 Dify 里的设置保持一致：关闭思考模式，temperature 才生效
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Dify 工作流的服务 API（在应用的"访问 API"页面创建密钥）
# 写 127.0.0.1 不写 localhost：Windows 上 localhost 先解析成 IPv6 的 ::1，Dify 只监听 IPv4，每次请求白等约 2 秒
DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_API_KEY=

# 飞书自建应用（开发者后台"凭证与基础信息"）和评分卡所在的多维表格链接
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_URL=
# 以下四项由 tools/feishu_setup.py 写入；FEISHU_CHAT_ID 是应用机器人所在、接收每日汇总和出错提醒的群
FEISHU_APP_TOKEN=
FEISHU_SCORE_TABLE_ID=
FEISHU_DAILY_TABLE_ID=
FEISHU_CHAT_ID=
