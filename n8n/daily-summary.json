        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ receive_id: '__FEISHU_CHAT_ID__', msg_type: 'text', uuid: 'rqc-' + $execution.id, content: JSON.stringify({ text: $('算汇总').first().json.summary }) }) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 0
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "notes": "以应用身份发到应用机器人所在的群，群 ID 部署时从 .env 填入。uuid 取执行 ID，重试不会重复发。"
    },
    {
      "id": "7e4c0f31-0011-4c2a-9f61-7a8b0c1d0011",
      "name": "检查飞书返回",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// 飞书接口出错时也返回 HTTP 200，只在 code 里报错；这里不为 0 就让整次执行失败，交给出错流程。\nfor (const name of ['写入每日汇总', '推送到群']) {\n  const r = $(name).first().json;\n  if (r.code !== 0) throw new Error(`${name}失败 code ${r.code}: ${r.msg}`);\n}\nreturn $('算汇总').all();\n"
      }
    }
