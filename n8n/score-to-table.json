            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
              "leftValue": "={{ $json.code === 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5d3b9e20-0018-4c2a-9f61-7a8b0c1d0018",
      "name": "记为已处理",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        2880,
        -340
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "reply_qc_processed"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "conv_key": "={{ $('评分完成了吗').item.json.conv_key }}",
            "conv_id": "={{ $('评分完成了吗').item.json.conv_id }}",
            "status": "={{ $('评分完成了吗').item.json.status }}",
            "total": "={{ $('评分完成了吗').item.json.total }}",
            "record_id": "={{ $json.data.record.record_id }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "notes": "写进去之后，同样内容的对话不会再评。"
    },
    {
      "id": "5d3b9e20-0019-4c2a-9f61-7a8b0c1d0019",
      "name": "整理写表失败",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        -80
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const errorText = (j) => {\n  if (typeof j.error === 'string') return j.error;\n  const d = j.details ?? {};\n  const b = d.body && typeof d.body === 'object' ? d.body : {};\n  return [d.httpCode, b.code !== undefined ? `code ${b.code}: ${b.msg ?? ''}` : '', d.message ?? j.error?.message]\n    .filter(Boolean).join(' | ');\n};\n// 飞书换令牌或写表失败。HTTP 报错走错误输出（带 error）；业务报错是 HTTP 200 但 code 不为 0。\n// 先看 error：错误输出会并入上一步的字段，换令牌成功留下的 code: 0 也在里面。\nconst src = $('评分完成了吗').item.json;\nconst detail = $json.error !== undefined ? errorText($json) : `code ${$json.code}: ${$json.msg}`;\nreturn {\n  json: { conv_key: src.conv_key, conv_id: src.conv_id, done: false, status: 'feishu_error', detail: String(detail).slice(0, 500) },\n};\n"
      }
    },
    {
      "id": "5d3b9e20-0020-4c2a-9f61-7a8b0c1d0020",
      "name": "记下失败",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        3120,
        120
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "reply_qc_errors"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "source": "score",
            "workflow": "={{ $workflow.name }}",
            "execution_id": "={{ $execution.id }}",
            "conv_id": "={{ $json.conv_id }}",
            "conv_key": "={{ $json.conv_key }}",
            "message": "={{ $json.status + ($json.detail ? ': ' + $json.detail : '') }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "notes": "单条失败不打断其它对话；这些对话没进已处理表，下次触发会重试。"
    }
  ],
