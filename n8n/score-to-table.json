        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "2b7c5e1a-9d40-4f3e-8a6b-0c1d2e3f4a5b",
      "notes": "POST 一段对话、对话数组或 {conversations: [...]}，立即返回，评分在后台跑。"
    },
    {
      "id": "5d3b9e20-0002-4c2a-9f61-7a8b0c1d0002",
      "name": "每 30 分钟查收件箱",
